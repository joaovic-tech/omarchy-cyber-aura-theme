# Main background
theme[main_bg]="#09090ECC"

# Main text color
theme[main_fg]="#E0E6F0"

# Title color for boxes
theme[title]="#FF007F"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#00F0FF"

# Background color of selected item in processes box
theme[selected_bg]="#151521"

# Foreground color of selected item in processes box
theme[selected_fg]="#FF007F"

# Color of inactive/disabled text
theme[inactive_fg]="#7A7A9E"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#C561FF"

# Box outline and divider line color
theme[cpu_box]="#FF007F"
theme[mem_box]="#00FF9F"
theme[net_box]="#00F0FF"
theme[proc_box]="#C561FF"
theme[div_line]="#44445A"

# Temperature graph color
theme[temp_start]="#00FF9F"
theme[temp_mid]="#FFE700"
theme[temp_end]="#FF007F"

# CPU graph colors
theme[cpu_start]="#4D94FF"
theme[cpu_mid]="#C561FF"
theme[cpu_end]="#FF007F"

# Mem/Disk free meter
theme[free_start]="#00FF9F"
theme[free_mid]="#4D94FF"
theme[free_end]="#C561FF"

# Download graph colors
theme[download_start]="#4D94FF"
theme[download_mid]="#00F0FF"
theme[download_end]="#00FF9F"

# Upload graph colors
theme[upload_start]="#FF007F"
theme[upload_mid]="#C561FF"
theme[upload_end]="#FF5C8D"

# Text on top of graphs and the background of percentage meters
theme[graph_text]="#9A9FB8"
theme[meter_bg]="#151521"
